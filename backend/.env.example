# ==============================
# FaceAttend Step 9 Recovery
# ==============================

# OTP security
OTP_PEPPER=replace-with-a-long-random-secret
OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ------------------------------
# Email OTP (SMTP)
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=yourgmail@gmail.com
# SMTP_PASSWORD=your-16-character-google-app-password
# MAIL_FROM=yourgmail@gmail.com
# ------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# ------------------------------
# Phone OTP (Twilio)
# ------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
